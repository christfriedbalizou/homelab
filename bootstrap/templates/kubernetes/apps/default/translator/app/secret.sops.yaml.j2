---
# yaml-language-server: $schema=https://k8s-schemas.home-operations.com/core/secret_v1.json
apiVersion: v1
kind: Secret
metadata:
  name: translator-secrets
  namespace: default
stringData:
  DATABASE_URL: {{ ('postgresql+asyncpg://translator:' ~ translator_postgres_password ~ '@postgres-lb.storage.svc.cluster.local:5432/translator') | tojson }}
  TRANSLATION_PROVIDER_ID: {{ translator_provider_id | tojson }}
  TRANSLATION__PROVIDERS: {{ [
    {'id': translator_provider_id, 'configuration': {'kind': 'local', 'user_selectable': false, 'base_url': 'http://litellm.ai.svc.cluster.local:4000/v1', 'model': 'translategemma-4b-q4-local', 'concurrency': 1, 'read_timeout_seconds': 180, 'overall_timeout_seconds': 300}, 'api_key_file': '/run/secrets/litellm-api-key'},
    {'id': '81770d82-3f07-57c8-9f46-75cdb4716c7f', 'configuration': {'kind': 'local', 'user_selectable': true, 'base_url': 'http://litellm.ai.svc.cluster.local:4000/v1', 'model': 'qwen3-8b-q4-local', 'concurrency': 1, 'read_timeout_seconds': 600, 'overall_timeout_seconds': 900}, 'api_key_file': '/run/secrets/litellm-api-key'},
    {'id': '0165878e-54e7-5d03-9ca2-e5b33d2d4231', 'configuration': {'kind': 'local', 'user_selectable': true, 'base_url': 'http://litellm.ai.svc.cluster.local:4000/v1', 'model': 'qwen3-14b-q4-local', 'concurrency': 1, 'read_timeout_seconds': 600, 'overall_timeout_seconds': 900}, 'api_key_file': '/run/secrets/litellm-api-key'},
    {'id': 'daf4ff4f-255f-5dd4-b1a9-d619be84e3ee', 'configuration': {'kind': 'local', 'user_selectable': true, 'base_url': 'http://litellm.ai.svc.cluster.local:4000/v1', 'model': 'qwen3-32b-q4-local', 'concurrency': 1, 'read_timeout_seconds': 600, 'overall_timeout_seconds': 900}, 'api_key_file': '/run/secrets/litellm-api-key'},
    {'id': translator_public_provider_id, 'configuration': {'kind': 'remote', 'user_selectable': true, 'base_url': 'https://litellm.${SECRET_DOMAIN}/v1', 'model': 'gpt-6-luna-openai-cloud', 'concurrency': 1, 'read_timeout_seconds': 180, 'overall_timeout_seconds': 300}, 'api_key_file': '/run/secrets/public-litellm-api-key'}
  ] | tojson | tojson }}
  INGESTION__S3_BUCKET: {{ translator_s3_bucket | tojson }}
---
# yaml-language-server: $schema=https://k8s-schemas.home-operations.com/core/secret_v1.json
apiVersion: v1
kind: Secret
metadata:
  name: translator-keys
  namespace: default
data:
  document-master-key: {{ translator_document_master_key | tojson }}
  provider-master-key: {{ translator_provider_master_key | tojson }}
stringData:
  translator-private-key: {{ translator_gpg_private_key | tojson }}
  translator-passphrase: {{ translator_gpg_passphrase | tojson }}
  s3-credentials: {{ {'access_key_id': translator_s3_access_key, 'secret_access_key': translator_s3_secret_key} | tojson | tojson }}
  oidc-client-secret: {{ translator_oidc_client_secret | tojson }}
  litellm-api-key: {{ translator_litellm_api_key | tojson }}
  public-litellm-api-key: {{ translator_public_litellm_api_key | tojson }}

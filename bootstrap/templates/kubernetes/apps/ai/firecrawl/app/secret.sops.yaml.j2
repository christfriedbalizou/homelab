---
# yaml-language-server: $schema=https://k8s-schemas.home-operations.com/core/secret_v1.json
apiVersion: v1
kind: Secret
metadata:
  name: firecrawl-secrets
  namespace: ai
stringData:
  NUQ_DATABASE_URL: {{ ("postgresql://firecrawl:" ~ firecrawl_postgres_password ~ "@postgres18-rw.storage.svc.cluster.local:5432/firecrawl") | tojson }}
  NUQ_DATABASE_URL_LISTEN: {{ ("postgresql://firecrawl:" ~ firecrawl_postgres_password ~ "@postgres18-rw.storage.svc.cluster.local:5432/firecrawl") | tojson }}
---
# yaml-language-server: $schema=https://k8s-schemas.home-operations.com/core/secret_v1.json
apiVersion: v1
kind: Secret
metadata:
  name: firecrawl-gateway-api-keys
  namespace: ai
stringData:
  opencode: {{ firecrawl_gateway_api_key | tojson }}

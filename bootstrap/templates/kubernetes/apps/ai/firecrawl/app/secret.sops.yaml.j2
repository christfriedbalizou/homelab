---
# yaml-language-server: $schema=https://k8s-schemas.home-operations.com/core/secret_v1.json
apiVersion: v1
kind: Secret
metadata:
  name: firecrawl-secrets
  namespace: ai
stringData:
  NUQ_DATABASE_URL: {{ ("postgresql://postgres:" ~ firecrawl_postgres_password ~ "@firecrawl-postgres.ai.svc.cluster.local:5432/postgres") | tojson }}
  NUQ_DATABASE_URL_LISTEN: {{ ("postgresql://postgres:" ~ firecrawl_postgres_password ~ "@firecrawl-postgres.ai.svc.cluster.local:5432/postgres") | tojson }}
---
# yaml-language-server: $schema=https://k8s-schemas.home-operations.com/core/secret_v1.json
apiVersion: v1
kind: Secret
metadata:
  name: firecrawl-postgres
  namespace: ai
stringData:
  POSTGRES_PASSWORD: {{ firecrawl_postgres_password | tojson }}
---
# yaml-language-server: $schema=https://k8s-schemas.home-operations.com/core/secret_v1.json
apiVersion: v1
kind: Secret
metadata:
  name: firecrawl-gateway-api-keys
  namespace: ai
stringData:
  opencode: {{ firecrawl_gateway_api_key | tojson }}

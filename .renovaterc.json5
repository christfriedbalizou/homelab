{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>christfriedbalizou/renovate"],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  ignorePaths: [
    "**/*.sops.*",
    "**/resources/**",
    "**/configs/**",
    "**/config/**",
  ],
  flux: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  helmfile: {
    managerFilePatterns: [
      "/(^|/)helmfile\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/",
      "/(^|/)helmfile\\.d/.+\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/",
    ],
  },
  kubernetes: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  kustomize: {
    managerFilePatterns: ["/^kustomization\\.ya?ml(?:\\.j2)?$/"],
  },
  packageRules: [
    // NVIDIA chart values split the image path across repository and image.
    {
      description: "Resolve NVIDIA DCGM exporter image",
      matchFileNames: ["kubernetes/apps/kube-system/device-plugin/nvidia/app/helmrelease.yaml"],
      matchDatasources: ["docker"],
      matchPackageNames: ["dcgm-exporter"],
      overridePackageName: "nvcr.io/nvidia/k8s/dcgm-exporter",
    },
    {
      description: "Resolve NVIDIA GPU operator and validator images",
      matchFileNames: ["kubernetes/apps/kube-system/device-plugin/nvidia/app/helmrelease.yaml"],
      matchDatasources: ["docker"],
      matchPackageNames: ["gpu-operator"],
      overridePackageName: "nvcr.io/nvidia/gpu-operator",
    },
    {
      description: "Resolve NVIDIA driver manager image",
      matchFileNames: ["kubernetes/apps/kube-system/device-plugin/nvidia/app/helmrelease.yaml"],
      matchDatasources: ["docker"],
      matchPackageNames: ["k8s-driver-manager"],
      overridePackageName: "nvcr.io/nvidia/cloud-native/k8s-driver-manager",
    },
  ],
  customManagers: [
    {
      customType: "regex",
      description: "Update vscode dotfiles tag",
      managerFilePatterns: [
        "/(^|/)kubernetes/apps/default/vscode/app/helmrelease\\.ya?ml$/",
      ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+DOTFILES_VERSION:\\s*\"?(?<currentValue>v?[^\"\\s]+)\"?",
      ],
      versioningTemplate: "semver",
    },
  ],
}

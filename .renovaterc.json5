{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#8.1.0",
    "github>home-operations/renovate-presets//apps/cnpg.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/llamacpp.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/searxng.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#8.1.0",
    // Keep repository policies without importing duplicate dependency managers.
    "github>christfriedbalizou/renovate:autoMerge.json5",
    "github>christfriedbalizou/renovate:groups.json5",
    "github>christfriedbalizou/renovate:labels.json5",
    ":timezone(Europe/London)",
  ],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  ignorePaths: [
    "**/*.sops.*",
    "**/resources/**",
    "**/configs/**",
    "**/config/**",
  ],
  flux: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  helmfile: {
    managerFilePatterns: [
      "/(^|/)helmfile\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/",
      "/(^|/)helmfile\\.d/.+\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/",
    ],
  },
  kubernetes: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  kustomize: {
    managerFilePatterns: ["/^kustomization\\.ya?ml(?:\\.j2)?$/"],
  },
  packageRules: [
    {
      description: "Derive Immich's pgvector version from the pinned PostgreSQL image",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      pinDigests: true,
      automerge: false,
      groupName: "postgresql",
      postUpgradeTasks: {
        commands: ["node .github/scripts/sync-pgvector.mjs --write"],
        fileFilters: ["kubernetes/apps/storage/cloudnative-pg/databases/immich.yaml"],
        executionMode: "branch",
      },
    },
    {
      description: "Translator releases require matching source/assets and a database backup",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/christfriedbalizou/translator"],
      automerge: false,
      pinDigests: true,
      groupName: "translator",
    },
    {
      description: "Keep Talos installation and rolling upgrade versions together",
      matchDatasources: ["custom.talos-factory"],
      matchPackageNames: ["siderolabs/talos"],
      versioning: "semver",
      groupName: "talos",
      minimumGroupSize: 2,
    },
    {
      // Talos manages the control-plane images; only kubelet is tracked here.
      description: "Allow Kubernetes updates without five separate component images",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/siderolabs/kubelet"],
      groupName: "kubernetes",
      minimumGroupSize: 1,
    },
    // NVIDIA chart values split the image path across repository and image.
    {
      description: "Resolve NVIDIA DCGM exporter image",
      matchFileNames: ["kubernetes/apps/kube-system/device-plugin/nvidia/app/helmrelease.yaml"],
      matchDatasources: ["docker"],
      matchPackageNames: ["dcgm-exporter"],
      overridePackageName: "nvcr.io/nvidia/k8s/dcgm-exporter",
    },
    {
      description: "Resolve NVIDIA GPU operator and validator images",
      matchFileNames: ["kubernetes/apps/kube-system/device-plugin/nvidia/app/helmrelease.yaml"],
      matchDatasources: ["docker"],
      matchPackageNames: ["gpu-operator"],
      overridePackageName: "nvcr.io/nvidia/gpu-operator",
    },
    {
      description: "Resolve NVIDIA driver manager image",
      matchFileNames: ["kubernetes/apps/kube-system/device-plugin/nvidia/app/helmrelease.yaml"],
      matchDatasources: ["docker"],
      matchPackageNames: ["k8s-driver-manager"],
      overridePackageName: "nvcr.io/nvidia/cloud-native/k8s-driver-manager",
    },
    {
      description: "Review NVIDIA GPU Operator chart and controller images together",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "nvcr.io/nvidia/cloud-native-charts/gpu-operator",
        "nvcr.io/nvidia/gpu-operator",
        "gpu-operator",
      ],
      groupName: "nvidia-gpu-operator",
      automerge: false,
      prBodyNotes: [
        "Keep the OCI chart tag and the operator/validator image versions aligned. Grouping collects available updates but does not guarantee NVIDIA publishes matching versions simultaneously; check all three before merging.",
      ],
    },
  ],
}
